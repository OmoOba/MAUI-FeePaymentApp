<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="FeePaymentApp.FeePaymentPage"
    Title="Fee Payment"
    BackgroundColor="{StaticResource PageBackgroundColor}">

    <VerticalStackLayout Padding="0">
        <!-- Header -->
        <Grid
            ColumnDefinitions="*"
            RowDefinitions="*"
            BackgroundColor="{StaticResource PrimaryColor}"
            Padding="20,30">
            <VerticalStackLayout Spacing="5">
                <Label
                    Text="Student Fee Payment"
                    FontSize="24"
                    FontAttributes="Bold"
                    TextColor="White" />
                <Label
                    Text="Complete your payment information"
                    FontSize="14"
                    TextColor="{StaticResource AccentColor}" />
            </VerticalStackLayout>
        </Grid>

        <!-- Form Content -->
        <ScrollView>
            <VerticalStackLayout
                Padding="20"
                Spacing="20">

                <!-- Matric Number Section -->
                <Frame
                    CornerRadius="12"
                    BorderColor="{StaticResource PrimaryColor}"
                    BorderWidth="1"
                    Padding="15"
                    HasShadow="True">
                    <VerticalStackLayout Spacing="8">
                        <Label
                            Text="Matric Number"
                            FontSize="14"
                            FontAttributes="Bold"
                            TextColor="{StaticResource TextColor}" />

                        <Grid
                            ColumnDefinitions="*,auto"
                            Spacing="10">
                            <Entry
                                x:Name="MatricEntry"
                                Grid.Column="0"
                                Placeholder="Enter matric number"
                                Keyboard="Text"
                                BackgroundColor="White"
                                TextColor="{StaticResource TextColor}"
                                PlaceholderColor="#999999"
                                Padding="12" />

                            <Button
                                Grid.Column="1"
                                Text="Verify"
                                BackgroundColor="{StaticResource AccentColor}"
                                TextColor="White"
                                CornerRadius="8"
                                WidthRequest="80"
                                Clicked="OnVerifyMatricClicked"
                                IsEnabled="True" />
                        </Grid>

                        <ActivityIndicator
                            x:Name="LoadingIndicator"
                            IsRunning="False"
                            Color="{StaticResource PrimaryColor}"
                            IsVisible="False" />
                    </VerticalStackLayout>
                </Frame>

                <!-- Student Info Display -->
                <Frame
                    x:Name="StudentInfoFrame"
                    CornerRadius="12"
                    BorderColor="#E0E0E0"
                    BorderWidth="1"
                    Padding="15"
                    HasShadow="True"
                    IsVisible="False">
                    <VerticalStackLayout Spacing="12">
                        <Label
                            Text="Student Information"
                            FontSize="14"
                            FontAttributes="Bold"
                            TextColor="{StaticResource PrimaryColor}" />

                        <Grid
                            ColumnDefinitions="auto,*"
                            RowDefinitions="auto,auto,auto,auto"
                            ColumnSpacing="10"
                            RowSpacing="8">
                            <Label
                                Grid.Row="0"
                                Grid.Column="0"
                                Text="Name:"
                                FontSize="12"
                                FontAttributes="Bold"
                                TextColor="{StaticResource TextColor}" />
                            <Label
                                x:Name="StudentNameLabel"
                                Grid.Row="0"
                                Grid.Column="1"
                                FontSize="12"
                                TextColor="{StaticResource TextColor}" />

                            <Label
                                Grid.Row="1"
                                Grid.Column="0"
                                Text="Email:"
                                FontSize="12"
                                FontAttributes="Bold"
                                TextColor="{StaticResource TextColor}" />
                            <Label
                                x:Name="StudentEmailLabel"
                                Grid.Row="1"
                                Grid.Column="1"
                                FontSize="12"
                                TextColor="{StaticResource TextColor}" />

                            <Label
                                Grid.Row="2"
                                Grid.Column="0"
                                Text="Department:"
                                FontSize="12"
                                FontAttributes="Bold"
                                TextColor="{StaticResource TextColor}" />
                            <Label
                                x:Name="StudentDepartmentLabel"
                                Grid.Row="2"
                                Grid.Column="1"
                                FontSize="12"
                                TextColor="{StaticResource TextColor}" />

                            <Label
                                Grid.Row="3"
                                Grid.Column="0"
                                Text="Level:"
                                FontSize="12"
                                FontAttributes="Bold"
                                TextColor="{StaticResource TextColor}" />
                            <Label
                                x:Name="StudentLevelLabel"
                                Grid.Row="3"
                                Grid.Column="1"
                                FontSize="12"
                                TextColor="{StaticResource TextColor}" />
                        </Grid>
                    </VerticalStackLayout>
                </Frame>

                <!-- Fee Type Section -->
                <Frame
                    CornerRadius="12"
                    BorderColor="{StaticResource PrimaryColor}"
                    BorderWidth="1"
                    Padding="15"
                    HasShadow="True">
                    <VerticalStackLayout Spacing="8">
                        <Label
                            Text="Fee Type"
                            FontSize="14"
                            FontAttributes="Bold"
                            TextColor="{StaticResource TextColor}" />

                        <Picker
                            x:Name="FeeTypePicker"
                            Title="Choose fee type"
                            BackgroundColor="White"
                            TextColor="{StaticResource TextColor}"
                            SelectedIndexChanged="OnFeeTypeChanged">
                            <Picker.ItemsSource>
                                <x:Array Type="{x:Type x:String}">
                                    <x:String>Acceptance fee</x:String>
                                    <x:String>Verification fee</x:String>
                                    <x:String>School fee</x:String>
                                </x:Array>
                            </Picker.ItemsSource>
                        </Picker>

                        <Label
                            x:Name="FeeAmountLabel"
                            IsVisible="False"
                            FontSize="12"
                            TextColor="{StaticResource AccentColor}"
                            FontAttributes="Bold" />
                    </VerticalStackLayout>
                </Frame>

                <!-- Level Section -->
                <Frame
                    CornerRadius="12"
                    BorderColor="{StaticResource PrimaryColor}"
                    BorderWidth="1"
                    Padding="15"
                    HasShadow="True">
                    <VerticalStackLayout Spacing="8">
                        <Label
                            Text="Academic Level"
                            FontSize="14"
                            FontAttributes="Bold"
                            TextColor="{StaticResource TextColor}" />

                        <Picker
                            x:Name="LevelPicker"
                            Title="Choose level"
                            BackgroundColor="White"
                            TextColor="{StaticResource TextColor}">
                            <Picker.ItemsSource>
                                <x:Array Type="{x:Type x:String}">
                                    <x:String>100</x:String>
                                    <x:String>200</x:String>
                                    <x:String>300</x:String>
                                    <x:String>400</x:String>
                                    <x:String>500</x:String>
                                </x:Array>
                            </Picker.ItemsSource>
                        </Picker>
                    </VerticalStackLayout>
                </Frame>

                <!-- Submit Button -->
                <Button
                    x:Name="SubmitButton"
                    Text="Proceed to Payment"
                    BackgroundColor="{StaticResource PrimaryColor}"
                    TextColor="White"
                    FontAttributes="Bold"
                    FontSize="16"
                    CornerRadius="12"
                    HeightRequest="50"
                    Clicked="OnSubmitClicked"
                    Margin="0,10" />

                <Label
                    x:Name="ErrorLabel"
                    IsVisible="False"
                    TextColor="#FF4444"
                    FontSize="12"
                    HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </ScrollView>
    </VerticalStackLayout>
</ContentPage>
